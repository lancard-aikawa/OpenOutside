{
  "name": "open-outside",
  "displayName": "Open Outside",
  "description": "Open chosen file types in the OS default app, and list the files that appear in the Claude Code chat.",
  "version": "0.0.4",
  "publisher": "local",
  "license": "MIT",
  "private": true,
  "repository": { "type": "git", "url": "https://example.invalid/open-outside" },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "customEditors": [
      {
        "viewType": "openOutside.external",
        "displayName": "Open Outside (OS default app)",
        "selector": [{ "filenamePattern": "*" }],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        { "id": "openOutside.chatFiles", "name": "Chat Files", "icon": "$(comment-discussion)" }
      ]
    },
    "commands": [
      { "command": "openOutside.open", "title": "Open Outside", "category": "Open Outside" },
      { "command": "openOutside.refresh", "title": "Refresh", "icon": "$(refresh)", "category": "Open Outside" },
      { "command": "openOutside.openItem", "title": "Outside", "icon": "$(link-external)" },
      { "command": "openOutside.openFolder", "title": "Folder", "icon": "$(folder-opened)" },
      { "command": "openOutside.reveal", "title": "Explorer", "icon": "$(folder-opened)" },
      { "command": "openOutside.edit", "title": "Edit", "icon": "$(edit)" },
      { "command": "openOutside.copyPath", "title": "Copy Path", "icon": "$(copy)" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "openOutside.open", "when": "!explorerResourceIsFolder", "group": "navigation@99" }
      ],
      "view/title": [
        { "command": "openOutside.refresh", "when": "view == openOutside.chatFiles", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "openOutside.reveal", "when": "view == openOutside.chatFiles && viewItem == chatFile", "group": "inline@1" },
        { "command": "openOutside.openItem", "when": "view == openOutside.chatFiles && viewItem == chatFile", "group": "inline@2" },
        { "command": "openOutside.openFolder", "when": "view == openOutside.chatFiles && viewItem == chatFolder", "group": "inline@1" },
        { "command": "openOutside.edit", "when": "view == openOutside.chatFiles && viewItem == chatFile", "group": "1_open@1" },
        { "command": "openOutside.openItem", "when": "view == openOutside.chatFiles && viewItem == chatFile", "group": "1_open@2" },
        { "command": "openOutside.reveal", "when": "view == openOutside.chatFiles && viewItem == chatFile", "group": "1_open@3" },
        { "command": "openOutside.openFolder", "when": "view == openOutside.chatFiles && viewItem == chatFolder", "group": "1_open@1" },
        { "command": "openOutside.copyPath", "when": "view == openOutside.chatFiles", "group": "2_copy@1" }
      ]
    }
  }
}
